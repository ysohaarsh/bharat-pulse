  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --passWithNoTests",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",

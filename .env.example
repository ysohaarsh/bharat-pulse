NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site origin used in auth email links, e.g. https://bharat-pulse.vercel.app
NEXT_PUBLIC_SITE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for /api/ingest and /api/brief (pg_cron sends it as a Bearer token). 32+ chars.
CRON_SECRET=

# --- Data sources (all free) ---
# Open Government Data Platform India: CPCB real-time AQI + Agmarknet mandi prices.
# Sign up at https://data.gov.in → My Account → generate API key. Without it AQI falls back to Open-Meteo.
DATA_GOV_IN_API_KEY=
# NASA FIRMS active fires. Free key by email: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# --- Indian-language AI (optional; translation is skipped without keys) ---
# Bhashini (MeitY): register at https://bhashini.gov.in/ulca → profile → generate API key.
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
# Sarvam AI (fallback translator): https://dashboard.sarvam.ai — ₹100 free credits on signup.
SARVAM_API_KEY=

# Optional: AI-written India Brief via any OpenAI-compatible API (free tiers: Groq, Gemini, OpenRouter, Ollama).
# Without a key, /api/brief writes an extractive digest instead. See lib/brief/provider.ts.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
